# ---------------------------------------------------------------------------
# Géoportail du Parc National de Belezma — variables d'environnement de l'API
# Copiez ce fichier vers server/.env et renseignez les valeurs.
# Aucun secret réel ne doit être versionné.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# --- Base de données -------------------------------------------------------
# Local (docker compose up -d) :
MONGODB_URI=mongodb://localhost:27017/belezma
# MongoDB Atlas :
# MONGODB_URI=mongodb+srv://<utilisateur>:<motdepasse>@<cluster>.mongodb.net/belezma?retryWrites=true&w=majority

# --- Authentification ------------------------------------------------------
# Au moins 32 caractères chacun. Générez-les avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# --- Client ----------------------------------------------------------------
# Liste blanche CORS, séparée par des virgules.
CLIENT_ORIGIN=http://localhost:5173

# --- Cloudinary (photographies et fichiers SIG déposés) --------------------
# Facultatif en développement : sans ces valeurs, les dépôts de fichiers sont
# refusés avec un message explicite plutôt que d'échouer en cours de route.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=belezma

# --- Courrier sortant (vérification d'adresse, mot de passe oublié) --------
# Facultatif en développement : les messages sont alors journalisés.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
SMTP_FROM=Géoportail Belezma <ne-pas-repondre@belezma.dz>

# --- Exploitation ----------------------------------------------------------
LOG_LEVEL=info
# Mettre à true derrière un proxy (Render, Railway, Nginx) pour que la
# limitation de débit voie la vraie adresse IP du client.
TRUST_PROXY=false
